APP_ENV=development
DB_PATH=./data/pipeline.db
CACHE_DIR=./data/cache
DOWNLOAD_DIR=./data/downloads
FRAME_DIR=./data/frames
PREVIEW_DIR=./data/previews
LOG_DIR=./data/logs
USER_AGENT=ia-kissing-pipeline/0.1 (contact: operator@example.com)
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE_NAME=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_KISS_DETECTOR_CLASSES=head

# Optional S3-compatible media storage for previews and clips.
# In systemd, prefix each line with Environment=.
MEDIA_STORAGE_BACKEND=local
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
MEDIA_S3_REGION=gra
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PUBLIC_BASE_URL=
MEDIA_S3_ACL=public-read
MEDIA_S3_CACHE_CONTROL=public, max-age=31536000, immutable
